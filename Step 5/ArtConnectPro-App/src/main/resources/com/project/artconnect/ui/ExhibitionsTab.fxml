<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.project.artconnect.ui.ExhibitionController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <TableView fx:id="exhibitionTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="deleteColumn" text="Delete" prefWidth="60"/>

            <TableColumn fx:id="titleColumn" text="Title" prefWidth="150" />
            <TableColumn fx:id="galleryColumn" text="Gallery" prefWidth="110" />
            <TableColumn fx:id="sdateColumn" text="Start Date" prefWidth="100" />
            <TableColumn fx:id="edateColumn" text="End Date" prefWidth="100" />
            <TableColumn fx:id="themeColumn" text="Theme" prefWidth="100" />
            <TableColumn fx:id="curatorColumn" text="Curator Name" prefWidth="110" />
            <TableColumn fx:id="artworksColumn" text="Artworks" prefWidth="200" />
            <TableColumn fx:id="openingHoursColumn" text="Opening Hours" prefWidth="210" />
        </columns>
    </TableView>
</VBox>
