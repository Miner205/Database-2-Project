<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.project.artconnect.ui.ArtworkController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <TableView fx:id="artworkTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="deleteColumn" text="Delete" prefWidth="60"/>

            <TableColumn fx:id="titleColumn" text="Title" prefWidth="150" />
            <TableColumn fx:id="artistColumn" text="Artist" prefWidth="120" />
            <TableColumn fx:id="typeColumn" text="Type" prefWidth="110" />
            <TableColumn fx:id="mediumColumn" text="Medium" prefWidth="100" />
            <TableColumn fx:id="priceColumn" text="Price" prefWidth="90" />
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="100" />
            <TableColumn fx:id="yearColumn" text="Creation Year" prefWidth="100" />
            <TableColumn fx:id="dimensionsColumn" text="Dimensions" prefWidth="150" />
            <TableColumn fx:id="tagsColumn" text="Tags" prefWidth="150" />
        </columns>
    </TableView>
</VBox>
